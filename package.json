{
  "name": "@sunnygg/distributor",
  "version": "1.0.0",
  "description": "Synchronize Agent Skills across supported agent harnesses.",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "distributor": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skills",
    "cli"
  ],
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.2",
    "distributor": "link:",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/set-bin-mode.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:windows-symlinks": "node scripts/check-windows-symlink.mjs && vitest run test/unit/path-primitives.test.ts test/unit/sync-apply.test.ts test/unit/state.test.ts",
    "smoke:cli": "pnpm build && node dist/bin.js --help",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --dry-run",
    "package:smoke": "node scripts/verify-package.mjs"
  }
}